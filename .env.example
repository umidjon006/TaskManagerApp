# Nusxa oling:  cp .env.example .env   — keyin qiymatlarni to'ldiring.
# .env faylini HECH QACHON GitHub'ga yuklamang (u .gitignore da).

# ---- Majburiy ----

# Sayt ochiladigan yagona port: http://SERVER_IP:8080
APP_PORT=8080

POSTGRES_DB=vazifalar
POSTGRES_USER=vazifalar
# Faqat harf va raqam ishlating. Yaratish: openssl rand -hex 16
POSTGRES_PASSWORD=ALMASHTIRING_kuchli_parol

# Token imzolash kaliti. Yaratish: openssl rand -hex 32
JWT_SECRET=ALMASHTIRING_uzun_tasodifiy_satr

# ---- Ixtiyoriy: bo'sh qolsa, shu funksiya o'chiq bo'ladi, sayt baribir ishlaydi ----

# AI (muhimlikni baholash va "nimadan boshlay?"). Kalit: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Telegram bot: @BotFather → /newbot → berilgan tokenni shu yerga qo'ying
TELEGRAM_BOT_TOKEN=

# Vaqt zonasi (kunlik/haftalik/oylik davrlar va eslatmalar shu bo'yicha hisoblanadi)
APP_TIMEZONE=Asia/Tashkent

# Soatlik eslatma yuborilmaydigan soatlar (23:00–07:00). O'chirish uchun bo'sh qoldiring: QUIET_HOURS=
QUIET_HOURS=23-7

# Kun yakuni hisoboti yuboriladigan soat (0–23). O'chirish uchun bo'sh qoldiring.
DAILY_SUMMARY_HOUR=21
