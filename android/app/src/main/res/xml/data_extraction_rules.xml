<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+). Auto Backup: faqat SQLite bazasi (@capacitor-community/sqlite →
     context.getDatabasePath("vazifalarSQLite.db") = /data/data/<paket>/databases/).
     "." — butun databases/ papkasi: asosiy fayl bilan birga -journal ham, yozish o'rtasida
     zaxira olinsa izchil tiklansin. Qolgan hamma narsa (WebView localStorage — vaqtinchalik
     UI holati, eslatmalar plaginining SharedPreferences'i — ilova ochilganda qayta jadvallanadi,
     cache/) <include> bo'lgani uchun avtomatik chiqarib tashlanadi. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
